<view class="container">
  <view class="title-wrapper">
    <text class="title">赛事详情</text>
  </view>
  <form class="form" bindsubmit="onConfirm">
    <view class="form-item">
      <text>姓名:</text>
      <input class="form-input" placeholder="record.name" name="username" required />
    </view>
    <view class="form-item">
      <text>身份证号:</text>
      <input class="form-input" placeholder="record.id" name="idNumber" required />
    </view>
    <view class="form-item">
      <text>性别:</text>
      <picker mode="selector" range="{{genders}}" bindchange="onGenderChange">
        <view class="picker">{{selectedGender || '请选择性别'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text>年龄:</text>
      <input class="form-input" placeholder="record.age" name="age" type="number" required />
    </view>
    <view class="form-item">
      <text>学校/单位:</text>
      <input class="form-input" placeholder="record.institution" name="institution" required />
    </view>
    <view class="form-item">
      <text>手机:</text>
      <input class="form-input" placeholder="record.phone_number" name="phone" type="number" required />
    </view>
    <view class="form-item">
      <text>证件照:</text>
      <button bindtap="chooseAvatar">
        <text wx:if="!{{idPhotoPath}}">上传证件照</text>
        <image wx:if="{{idPhotoPath}}" src="{{idPhotoPath}}" mode="widthFix"></image>
      </button>
    </view>
    <view class="form-item">
      <text>赛事:</text>
      <picker mode="selector" range="{{tournamentNames}}" bindchange="onTournamentSelect">
        <view class="picker">{{selectedTournament || '请选择赛事'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text>分组:</text>
      <picker mode="selector" range="{{groups}}" bindchange="onGroupChange">
        <view class="picker">{{selectedGroup || '请选择分组'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text>角色:</text>
      <picker mode="selector" range="{{roles}}" bindchange="onRoleChange">
        <view class="picker">{{selectedRole || '请选择角色'}}</view>
      </picker>
    </view>
    <button class="submit-btn" formType="submit">提交报名</button>
  </form>
</view>
